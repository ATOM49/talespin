# MongoDB runs through the root Docker Compose stack.
DATABASE_URL="mongodb://localhost:27017/talespin?replicaSet=rs0"

# Server-side connection to apps/watcher.
WATCHER_API_URL="http://localhost:4000"
# Must match the watcher's WATCHER_API_KEY.
WATCHER_API_KEY=""
WATCHER_GENERATION_TIMEOUT_MS="300000"
WORLD_GENERATION_WORKER_POLL_INTERVAL_MS="1000"
# Where queued generation jobs run: "worker" (the worker processes) or
# "inline" (after responses, for serverless). Defaults to inline on Vercel.
GENERATION_JOB_RUNNER=""
# Bearer secret for the /api/internal/generation-jobs cron route.
CRON_SECRET=""

# Public CDN origin for generated images (must match apps/watcher). next/image
# only optimizes images from this host; set it for both build and start.
MINIO_PUBLIC_HOST="http://localhost:9000"
MINIO_BUCKET="images"
MINIO_PUBLIC_BASE_URL=""

# Local Auth.js / NextAuth configuration.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Development-only credentials account. Disable and configure both OAuth
# providers for production-like authentication.
E2E_TEST_MODE="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Optional unless exercising CopilotKit-assisted UI.
NEXT_PUBLIC_COPILOT_CLOUD_PUBLIC_API_KEY=""
