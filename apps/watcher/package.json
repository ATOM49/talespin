{
  "name": "@talespin/watcher",
  "version": "1.0.0",
  "type": "module",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 c8 node --test --loader ts-node/esm test/*/*.test.ts",
    "start": "npm run build:ts && fastify start -l info -p 4000 dist/app.js",
    "start:prod": "fastify start -l info -a 0.0.0.0 -p ${PORT:-4000} dist/app.js",
    "build:ts": "tsc -p tsconfig.build.json",
    "watch:ts": "tsc -w -p tsconfig.build.json",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l debug -p 4000 -P dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/env": "^5.0.2",
    "@fastify/sensible": "^6.0.0",
    "@langchain/openai": "^1.0.0",
    "@talespin/ai": "workspace:*",
    "@talespin/cdn": "workspace:*",
    "@talespin/schema": "workspace:*",
    "dotenv": "^17.0.1",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.0",
    "langchain": "^0.3.29"
  },
  "devDependencies": {
    "@types/node": "^22.1.0",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "fastify-cli": "^7.4.0",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0"
  },
  "directories": {
    "test": "test"
  }
}
